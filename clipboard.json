{"text": "<!DOCTYPE html>\n<html>\n<head>\n<title>\u547d\u4ee4\u901a\u9053\u6d4b\u8bd5</title>\n<style>\nbody { background: #111; color: #fff; font-family: monospace; padding: 20px; }\n.result { padding: 8px; margin: 6px 0; border-radius: 6px; }\n.ok { background: #0a3; }\n.fail { background: #a30; }\n.pending { background: #333; }\nbutton { padding: 8px 16px; margin: 4px; background: #0af; color: #000; border: none; border-radius: 6px; cursor: pointer; font-size: 14px; }\n</style>\n</head>\n<body>\n<h2>\u547d\u4ee4\u901a\u9053\u81ea\u52a8\u6d4b\u8bd5</h2>\n<button onclick=\"runAll()\">\ud83d\ude80 \u5f00\u59cb\u6d4b\u8bd5\u6240\u6709\u65b9\u6848</button>\n<div id=\"log\"></div>\n\n<script>\nvar URL = \"https://script.google.com/macros/s/AKfycbxxkxmRkkHodtxMV50sjiQwIZ9ep5o9nCaRyGfIvOmolAUfJS3A0c-HW8N9h7o273G19w/exec\";\n\nfunction log(msg, cls) {\n  var d = document.createElement('div');\n  d.className = 'result ' + (cls||'pending');\n  d.innerText = msg;\n  document.getElementById('log').appendChild(d);\n  return d;\n}\n\nasync function checkCmd(expected_id) {\n  await new Promise(r => setTimeout(r, 1500));\n  var r = await fetch(URL + '?action=get_cmd&t=' + Date.now());\n  var data = await r.json();\n  var cmd = JSON.parse(data.cmd || '{}');\n  return cmd.id == expected_id;\n}\n\nasync function runAll() {\n  document.getElementById('log').innerHTML = '';\n  var tid = Date.now();\n\n  // \u65b9\u68481: new Image GET\n  var d1 = log('\u65b9\u68481: Image GET...');\n  try {\n    var id1 = tid + 1;\n    new Image().src = URL + '?action=set_cmd&cmd=' + encodeURIComponent(JSON.stringify({type:'test',id:id1})) + '&t=' + Date.now();\n    var ok1 = await checkCmd(id1);\n    d1.className = 'result ' + (ok1 ? 'ok' : 'fail');\n    d1.innerText = '\u65b9\u68481: Image GET - ' + (ok1 ? '\u2705 \u6210\u529f' : '\u274c \u5931\u8d25');\n  } catch(e) { d1.className='result fail'; d1.innerText='\u65b9\u68481: Image GET - \u274c ' + e.message; }\n\n  // \u65b9\u68482: script\u6807\u7b7e\n  var d2 = log('\u65b9\u68482: Script\u6807\u7b7e...');\n  try {\n    var id2 = tid + 2;\n    var s = document.createElement('script');\n    s.src = URL + '?action=set_cmd&cmd=' + encodeURIComponent(JSON.stringify({type:'test',id:id2})) + '&t=' + Date.now();\n    document.head.appendChild(s);\n    var ok2 = await checkCmd(id2);\n    s.remove();\n    d2.className = 'result ' + (ok2 ? 'ok' : 'fail');\n    d2.innerText = '\u65b9\u68482: Script\u6807\u7b7e - ' + (ok2 ? '\u2705 \u6210\u529f' : '\u274c \u5931\u8d25');\n  } catch(e) { d2.className='result fail'; d2.innerText='\u65b9\u68482: Script\u6807\u7b7e - \u274c ' + e.message; }\n\n  // \u65b9\u68483: fetch GET\n  var d3 = log('\u65b9\u68483: fetch GET...');\n  try {\n    var id3 = tid + 3;\n    await fetch(URL + '?action=set_cmd&cmd=' + encodeURIComponent(JSON.stringify({type:'test',id:id3})) + '&t=' + Date.now());\n    var ok3 = await checkCmd(id3);\n    d3.className = 'result ' + (ok3 ? 'ok' : 'fail');\n    d3.innerText = '\u65b9\u68483: fetch GET - ' + (ok3 ? '\u2705 \u6210\u529f' : '\u274c \u5931\u8d25');\n  } catch(e) { d3.className='result fail'; d3.innerText='\u65b9\u68483: fetch GET - \u274c ' + e.message; }\n\n  // \u65b9\u68484: fetch POST no-cors text/plain\n  var d4 = log('\u65b9\u68484: POST no-cors text/plain...');\n  try {\n    var id4 = tid + 4;\n    fetch(URL, { method:'POST', mode:'no-cors', headers:{'Content-Type':'text/plain'}, body:JSON.stringify({action:'set_cmd',cmd:{type:'test',id:id4}}) });\n    var ok4 = await checkCmd(id4);\n    d4.className = 'result ' + (ok4 ? 'ok' : 'fail');\n    d4.innerText = '\u65b9\u68484: POST no-cors text/plain - ' + (ok4 ? '\u2705 \u6210\u529f' : '\u274c \u5931\u8d25');\n  } catch(e) { d4.className='result fail'; d4.innerText='\u65b9\u68484: POST no-cors text/plain - \u274c ' + e.message; }\n\n  // \u65b9\u68485: iframe GET\n  var d5 = log('\u65b9\u68485: iframe GET...');\n  try {\n    var id5 = tid + 5;\n    var iframe = document.createElement('iframe');\n    iframe.style.display = 'none';\n    iframe.src = URL + '?action=set_cmd&cmd=' + encodeURIComponent(JSON.stringify({type:'test',id:id5})) + '&t=' + Date.now();\n    document.body.appendChild(iframe);\n    var ok5 = await checkCmd(id5);\n    iframe.remove();\n    d5.className = 'result ' + (ok5 ? 'ok' : 'fail');\n    d5.innerText = '\u65b9\u68485: iframe GET - ' + (ok5 ? '\u2705 \u6210\u529f' : '\u274c \u5931\u8d25');\n  } catch(e) { d5.className='result fail'; d5.innerText='\u65b9\u68485: iframe GET - \u274c ' + e.message; }\n\n  log('\u2705 \u6d4b\u8bd5\u5b8c\u6210\uff01', 'ok');\n}\n</script>\n</body>\n</html>", "html": "", "time": "19:09:33"}